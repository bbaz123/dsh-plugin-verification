{
  "name": "dsh-plugin-verification",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Verification Gate: a host-plane plugin that runs Change -> Memory -> Regression -> Assertion -> Review before an Agent turn is allowed to close, records confirmed findings in a task error ledger, forces an OpenViking retrieval before any repair, and hands the finalization back to the Agent's existing global rules",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "meta": {
    "title": "DSH 验证门（Verification Gate）",
    "description": "任务结束前执行 变化分析 → 经验检索 → 回归 → 断言 → 审查；发现证据支持的问题时先检索 OpenViking 再交回 Agent 修复。"
  },
  "license": "Apache-2.0",
  "author": "bbaz123",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:offline": "node --test \"test/config.test.mjs\" \"test/protocol.test.mjs\" \"test/store.test.mjs\" \"test/compare.test.mjs\" \"test/adapters.test.mjs\" \"test/pipeline.test.mjs\" \"test/assertion-full-suite.test.mjs\"",
    "check": "node --check lib/index.js && node --test \"test/*.test.mjs\"",
    "verify": "node verify/wiring.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
